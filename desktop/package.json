{
  "name": "journal-desktop",
  "productName": "Journal",
  "version": "2.0.0",
  "description": "Le journal aquarelle dans sa propre fenêtre Windows, sans Docker",
  "author": "Dioman Keita",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node build/make-icon.mjs",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "44.10.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.journal.desktop",
    "productName": "Journal",
    "files": [
      "main.js",
      "preload.cjs",
      "renderer/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Journal"
    },
    "extraResources": [
      {
        "from": "../server/src",
        "to": "server/src"
      },
      {
        "from": "../server/node_modules",
        "to": "server/node_modules"
      },
      {
        "from": "../server/package.json",
        "to": "server/package.json"
      },
      {
        "from": "../web/dist",
        "to": "web"
      }
    ]
  }
}
