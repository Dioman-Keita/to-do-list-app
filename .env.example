# Copie ce fichier en .env puis remplis les valeurs.

# Nom affiché sur la couverture du journal
JOURNAL_NAME=Mon journal

# Le mot de passe du journal n'est plus ici : il se choisit au premier lancement et
# il est enregistré en base (empreinte chiffrée). APP_PASSWORD / SESSION_SECRET d'une
# ancienne installation sont importés automatiquement, puis peuvent être retirés.

# Protection du premier lancement : auto (défaut), always ou never.
# auto = code d'installation exigé seulement si le journal est joignable par d'autres
# machines (APP_BIND=0.0.0.0, DOMAIN, COOKIE_SECURE ou TRUST_PROXY). Le code s'affiche
# dans : docker compose logs app
# SETUP_CODE=auto

# Base de données
POSTGRES_DB=journal
POSTGRES_USER=journal
POSTGRES_PASSWORD=

# Correcteur LanguageTool (par défaut : le service local du docker-compose).
# Mettre SPELLCHECK_URL= (vide) pour le désactiver et garder seulement celui du navigateur.
# SPELLCHECK_URL=http://languagetool:8010

# Accès : 127.0.0.1 = seulement ce PC. 0.0.0.0 = tout le réseau local.
APP_BIND=127.0.0.1
APP_PORT=8080

# Sauvegardes
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=30
TZ=Europe/Paris

# --- VPS avec HTTPS (docker compose --profile https up -d) ---
# DOMAIN=journal.mondomaine.fr
# COOKIE_SECURE=true
# TRUST_PROXY=true
